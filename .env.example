NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME="Design Manager"
NEXT_PUBLIC_APP_THEME="light"
NEXT_PUBLIC_USE_MOCK_DATA=true
GEONAMES_USERNAME=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
# Base64-encoded or 64-character hex value representing exactly 32 random bytes.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
# Authenticates server-only scheduled workers and database Web Push callbacks.
CRON_SECRET=
# Equipment reference catalog worker. Keep disabled until an explicit full import succeeds.
ICECAT_SYNC_ENABLED=false
# Prefer an Icecat content token; alternatively configure username + password.
ICECAT_API_TOKEN=
ICECAT_USERNAME=
ICECAT_PASSWORD=
# Privileged tooling/worker uses the existing server-only Supabase client.
SUPABASE_SECRET_KEY=
# Generate once with `pnpm exec web-push generate-vapid-keys --json`.
# All values stay server-side; only the public key is returned to verified users.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:studioflow.notifications@gmail.com
# Used only by scripts/configure-web-push-local.mjs to configure local Vault.
# With Docker Desktop + WSL, use the reachable WSL eth0 IP instead if necessary.
WEB_PUSH_DISPATCH_URL=http://host.docker.internal:3000/api/push/dispatch
